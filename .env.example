# Copy this file to .env for local development. Never commit .env.
# Values are intentionally blank; fill them in your own .env or your shell environment.

# Required unless DEMO_MODE=true. Sent only in the X-Api-Key request header.
GNEWS_API_KEY=

# true serves the committed synthetic fixture, flagged synthetic: true. Default false.
DEMO_MODE=

# Optional until Phase 3.
BLUESKY_HANDLE=

# Optional until Phase 3.
BLUESKY_APP_PASSWORD=

# Optional until Phase 3.
DATABASE_URL=

# Comma-separated browser origins allowed to call the API, each as scheme://host[:port]
# with no trailing slash, path or wildcard. Unset means no cross-origin access.
# The local Vite dev server origin is http://localhost:5173
CORS_ORIGINS=

# Per-client-IP request limit for GET /analyze, format N/minute (for example 10/minute).
# Unset means 10 per minute. An invalid value stops startup.
RATE_LIMIT_ANALYZE=

# Per-client-IP request limit applied to every /v1 route, format N/minute (for example 60/minute).
# Unset means 60 per minute. An invalid value stops startup.
RATE_LIMIT_V1=

# The server is always started with --no-proxy-headers, so TRUST_PROXY_HEADERS and
# FORWARDED_ALLOW_IPS are the only proxy-trust switches.
# true only behind a trusted reverse proxy, so its X-Forwarded-For header sets the client
# address used for rate limiting. Unset means false (the header is ignored).
TRUST_PROXY_HEADERS=

# Comma-separated addresses of the proxy whose X-Forwarded-For header is trusted when
# TRUST_PROXY_HEADERS=true. Unset means 127.0.0.1 and ::1. Never use * unless the container
# is reachable only through the proxy.
FORWARDED_ALLOW_IPS=
