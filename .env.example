# Copy this file to .env for local development. Never commit .env.
# Values are intentionally blank; fill them in your own .env or your shell environment.

# Required unless DEMO_MODE=true. Sent only in the X-Api-Key request header.
GNEWS_API_KEY=

# true serves the committed synthetic fixture, flagged synthetic: true. Default false.
DEMO_MODE=

# Optional until Phase 3.
BLUESKY_HANDLE=

# Optional until Phase 3.
BLUESKY_APP_PASSWORD=

# Optional until Phase 3.
DATABASE_URL=

# Comma-separated browser origins allowed to call the API, each as scheme://host[:port]
# with no trailing slash, path or wildcard. Unset means no cross-origin access.
# The local Vite dev server origin is http://localhost:5173
CORS_ORIGINS=
