# Copy this file to .env for local development. Never commit .env.
# Values are intentionally blank; fill them in your own .env or your shell environment.

# Required unless DEMO_MODE=true. Sent only in the X-Api-Key request header.
GNEWS_API_KEY=

# true serves the committed synthetic fixture, flagged synthetic: true. Default false.
DEMO_MODE=

# Optional until Phase 3.
BLUESKY_HANDLE=

# Optional until Phase 3.
BLUESKY_APP_PASSWORD=

# Optional until Phase 3.
DATABASE_URL=

# Comma-separated browser origins allowed to call the API, each as scheme://host[:port]
# with no trailing slash, path or wildcard. Unset means no cross-origin access.
# The local Vite dev server origin is http://localhost:5173
CORS_ORIGINS=

# Per-client-IP request limit for GET /analyze, format N/minute (for example 10/minute).
# Unset means 10 per minute. An invalid value stops startup.
RATE_LIMIT_ANALYZE=

# Per-client-IP request limit applied to every /v1 route, format N/minute (for example 60/minute).
# Unset means 60 per minute. An invalid value stops startup.
RATE_LIMIT_V1=

# The server is always started with --no-proxy-headers, so TRUST_PROXY_HEADERS and
# FORWARDED_ALLOW_IPS are the only proxy-trust switches.
# true only behind a trusted reverse proxy, so its X-Forwarded-For header sets the client
# address used for rate limiting. Unset means false (the header is ignored).
TRUST_PROXY_HEADERS=

# Comma-separated addresses of the proxy whose X-Forwarded-For header is trusted when
# TRUST_PROXY_HEADERS=true. Unset means 127.0.0.1 and ::1. Never use * unless the container
# is reachable only through the proxy.
FORWARDED_ALLOW_IPS=

# --- Phase 3: collector operator values ---------------------------------------------------
# Secret key of the one-way account and URI pseudonyms (D-17). Read only by the ingest and
# erase commands, never by the API process. Never commit it; losing it breaks idempotent replay.
PSEUDONYM_SECRET=

# Optional operator contact (an email address or URL) appended to the collector's User-Agent.
# At most 200 printable ASCII characters, no line breaks.
COLLECTOR_CONTACT=

# --- Phase 3: policy parameters -----------------------------------------------------------
# Defaults live in src/truthtrail/core/policy.py and equal the owner-ratified values of the
# source spike (03-SPIKE.md). Unset means the default; an invalid value stops the command.
# Retention (OD-1): days text is kept (0 = never written)
RETENTION_TEXT_DAYS=
# Retention (OD-1): days cascade structure is kept
RETENTION_CASCADE_DAYS=
# Retention (OD-1): days delete tombstones are kept
RETENTION_TOMBSTONE_DAYS=
# Retention: days stored news context is kept
RETENTION_NEWS_DAYS=
# Retention: days after which a cascade without children is removed early (0 = disabled)
RETENTION_DORMANT_DAYS=
# Merge (OD-2): none or claim_group
CASCADE_MERGE_POLICY=
# Tracking (OD-3): file of allowlisted publisher domains (default: the packaged list)
TRACK_ALLOWLIST_FILE=
# Tracking (OD-3): cap on roots still accepting children
TRACK_MAX_ACTIVE_ROOTS=
# Tracking (OD-3): hours a root accepts children
TRACK_ROOT_TTL_HOURS=
# Tracking (OD-3): events stored per cascade
TRACK_MAX_EVENTS_PER_CASCADE=
# Tracking (OD-3): language tag a root must declare
TRACK_REQUIRE_LANG=
# Tracking (OD-3): true also seeds roots matching a stored news claim URL (option B)
TRACK_SEED_CLAIM_URL_MATCH=
# Tracking (OD-3): eligible roots kept per 10,000 (1 to 10000)
TRACK_SAMPLE_PER_10K=
# Storage: total stored events before ingest stops storing
STORE_MAX_EVENTS_TOTAL=
# Storage: database size budget in bytes
DB_BUDGET_BYTES=
# Storage: percent of the budget at which ingest stops storing
DB_STOP_PERCENT=
# Ingest: wall-clock seconds per run
INGEST_MAX_SECONDS=
# Ingest: frames received per run
INGEST_MAX_EVENTS=
# Ingest: rows stored per run
INGEST_MAX_STORED=
# Ingest: rows per write batch
INGEST_BATCH_ROWS=
# Ingest: seconds before a partial batch is written
INGEST_BATCH_SECONDS=
# Ingest: seconds the resume cursor is moved back
INGEST_REWIND_SECONDS=
# Ingest: oldest checkpoint resumed, in hours (below 36)
INGEST_MAX_RESUME_AGE_HOURS=
# Ingest: seconds after the last run at which data is reported stale
INGEST_STALE_AFTER_SECONDS=
# Ingest: Jetstream dialect, v2 or v1
INGEST_DIALECT=
# Ingest: comma-separated bare Jetstream hostnames, primary first
INGEST_HOSTS=
# News: provider calls per day
NEWS_DAILY_BUDGET=
# News: provider calls per job run
NEWS_MAX_CALLS_PER_RUN=
# News: hours before a topic is fetched again
NEWS_MIN_REFRESH_HOURS=
# News: topics tracked
NEWS_MAX_TOPICS=
# API: nodes per cascade tree response
MAX_TREE_NODES=
# API: default page size
PAGE_SIZE_DEFAULT=
# API: largest page size
PAGE_SIZE_MAX=
# API: buckets per timeline response
MAX_TIMELINE_BUCKETS=
