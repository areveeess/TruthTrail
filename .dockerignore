# The Dockerfile copies explicit paths (pyproject.toml, uv.lock, src), so this file is a second
# line of defence: nothing below can reach the build context by accident (D-01, D-18).
.git
.github
.venv
.env*
**/__pycache__
.pytest_cache
.mypy_cache
.ruff_cache
.hypothesis
.coverage*
htmlcov
legacy
# The recorded real-data fixture (src/truthtrail/data/recorded) is NOT ignored since plan 03-04:
# ingest/source.py (ReplaySource) is runtime code that replays it, and Phase 6 seeds the demo by
# replay inside the image (D-04). tests/test_container_files.py ties this rule to its readers.
tests
scripts
.planning
.claude
node_modules
package*.json
*.md
Dockerfile
.dockerignore
