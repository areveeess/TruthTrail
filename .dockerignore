# The Dockerfile copies explicit paths (pyproject.toml, uv.lock, src), so this file is a second
# line of defence: nothing below can reach the build context by accident (D-01, D-18).
.git
.github
.venv
.env*
**/__pycache__
.pytest_cache
.mypy_cache
.ruff_cache
.hypothesis
.coverage*
htmlcov
legacy
# The recorded real-data fixture is test input only (no runtime code reads it as of plan 03-01);
# a plan that serves or replays it inside the image must remove this line deliberately.
src/truthtrail/data/recorded
tests
scripts
.planning
.claude
node_modules
package*.json
*.md
Dockerfile
.dockerignore
